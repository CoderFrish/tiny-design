{
  "name": "tiny-design",
  "version": "1.0.0",
  "description": "This is a ui components library for solidjs.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.8.1",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/license/mit"
    },
    {
      "type": "Apache-2.0",
      "url": "https://opensource.org/license/gpl-3-0"
    }
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/types/core/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/types/core/index.d.ts"
    },
    "./dist/": {
      "import": "./dist/",
      "require": "./dist/"
    }
  },
  "scripts": {
    "dev:play": "pnpm --filter=@tiny-design/playground dev",
    "build": "pnpm --filter=@tiny-design/core build",
    "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:style": "stylelint \"**/*.{css}\"",
    "lint:fix": "pnpm lint:js -- --fix && npm run lint:style -- --fix",
    "format": "prettier --write ."
  },
  "files": [
    "dist",
    "licenses",
    "README.md",
    "LICENSE.md"
  ],
  "author": {
    "email": "1573880184@qq.com",
    "name": "Frish2021"
  },
  "categories": [
    "Themes",
    "Visualization"
  ],
  "keywords": [
    "solid",
    "solid-js",
    "solidjs",
    "tiny-design",
    "components",
    "design"
  ],
  "homepage": "https://github.com/CoderFrish/tiny-design",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderFrish/tiny-design.git"
  },
  "readme": "README.md",
  "bugs": {
    "url": "https://github.com/CoderFrish/tiny-design/issues"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.6",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-solid": "^2.11.7"
  },
  "peerDependencies": {
    "solid-js": "^1.9.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write --cache"
    ],
    "*.css": [
      "prettier --write --cache"
    ],
    "*.html": "prettier --write"
  }
}