{
    "name": "tiny-design",
    "version": "1.0.0",
    "description": "This is a ui components library for solidjs.",
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@10.8.1",
    "license": "GPL-3.0-only",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/types/core/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.mjs",
            "types": "./dist/types/core/index.d.ts"
        },
        "./dist/": {
            "import": "./dist/",
            "require": "./dist/"
        }
    },
    "scripts": {
        "dev:play": "pnpm --filter=@tiny-design/playground dev",
        "build": "pnpm --filter=@tiny-design/core build"
    },
    "files": [
        "dist",
        "licenses",
        "README.md",
        "LICENSE.md"
    ],
    "author": {
        "email": "1573880184@qq.com",
        "name": "Frish2021"
    },
    "categories": [
        "Themes",
        "Visualization"
    ],
    "keywords": [
        "solid",
        "solid-js",
        "solidjs",
        "tiny-design",
        "components",
        "design"
    ],
    "homepage": "https://github.com/CoderFrish/tiny-design",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/CoderFrish/tiny-design.git"
    },
    "readme": "README.md",
    "bugs": {
        "url": "https://github.com/CoderFrish/tiny-design/issues"
    },
    "devDependencies": {
        "@tsconfig/node20": "^20.1.6",
        "typescript": "^5.8.3",
        "vite": "^6.3.5",
        "vite-plugin-solid": "^2.11.7",
        "vite-plugin-dts": "^4.5.4",
        "vite-plugin-html": "^3.2.2"
    },
    "peerDependencies": {
        "solid-js": "^1.9.7"
    },
    "dependencies": {
        "@tiny-design/core": "workspace:^"
    }
}